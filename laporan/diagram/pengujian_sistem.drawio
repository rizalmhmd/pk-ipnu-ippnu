        </mxCell>
        <mxCell id="tbl_2" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:&#39;Times New Roman&#39;;font-size:12px;color:#000000;border:1px solid #000000;&quot;&gt;&lt;tr style=&quot;font-weight:bold;text-align:center;background-color:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:6%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:24%;&quot;&gt;Fitur yang Diuji&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:30%;&quot;&gt;Input yang Diberikan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:28%;&quot;&gt;Output yang Diharapkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:12%;&quot;&gt;Hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pendaftaran kegiatan (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Mengisi seluruh data formulir dengan lengkap dan benar (Nama, WA, Email, NIK 16 digit)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Data pendaftaran tersimpan ke basis data dan dialihkan ke halaman transaksi pembayaran&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pendaftaran kolom wajib kosong (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Kolom Nama Lengkap dan Nomor WhatsApp dikosongkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;Kolom ini wajib diisi&quot; pada field terkait&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Validasi nomor WhatsApp (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Nomor WhatsApp kurang dari 9 digit (contoh: 0812)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;Nomor WhatsApp minimal 9 digit&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Validasi format NIK (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;NIK kurang dari 16 digit (contoh: 8 digit angka)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;NIK harus berupa 16 digit angka&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Deteksi wilayah otomatis via NIK (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Input NIK 16 digit valid&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Sistem otomatis mendeteksi dan menampilkan jenis kelamin, tanggal lahir, kecamatan, kabupaten, dan provinsi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pendaftaran ganda / duplikat (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Mendaftar kembali dengan NIK atau No WA yang sudah terdaftar pada agenda yang sama&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;Anda sudah terdaftar pada kegiatan ini&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pendaftaran agenda yang ditutup (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Mengakses URL formulir kegiatan yang sudah ditutup status pendaftarannya&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Formulir dicegah dan muncul notifikasi bahwa pendaftaran telah ditutup&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="65" y="1082" width="720" height="386" as="geometry" />
        </mxCell>
        <mxCell id="sub_3" value="d.   Pengujian Fitur Pembayaran &amp; Transaksi" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
