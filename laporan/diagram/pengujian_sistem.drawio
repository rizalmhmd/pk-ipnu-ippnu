        <mxCell id="tbl_4" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:&#39;Times New Roman&#39;;font-size:12px;color:#000000;border:1px solid #000000;&quot;&gt;&lt;tr style=&quot;font-weight:bold;text-align:center;background-color:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:6%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:24%;&quot;&gt;Fitur yang Diuji&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:30%;&quot;&gt;Input yang Diberikan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:28%;&quot;&gt;Output yang Diharapkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:12%;&quot;&gt;Hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan metrik statistik (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Buka halaman dashboard admin (/admin/dashboard)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan kartu metrik total data (Berita, Artikel, Anggota, Agenda, Pendaftar, dll.) secara akurat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan indikator status sistem (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pemuatan halaman dashboard admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan kartu status &quot;Online &amp; Stabil&quot; dengan indikator titik hijau aktif&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan log aktivitas terbaru (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pemuatan seksi Aktivitas Terakhir pada dashboard&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan daftar aktivitas pendaftaran dan berita terbaru secara kronologis waktu&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pintasan cepat / Quick action (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik tombol pintasan [+ Post Berita] atau [+ Agenda Baru]&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Langsung dialihkan ke form pembuatan konten yang dipilih&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Ganti tema Dark / Light Mode (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik tombol pengubah tema pada header dashboard&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Tampilan antarmuka dashboard admin beralih antara tema gelap dan terang secara instan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
