        <mxCell id="tbl_3" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:&#39;Times New Roman&#39;;font-size:12px;color:#000000;border:1px solid #000000;&quot;&gt;&lt;tr style=&quot;font-weight:bold;text-align:center;background-color:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:6%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:24%;&quot;&gt;Fitur yang Diuji&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:30%;&quot;&gt;Input yang Diberikan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:28%;&quot;&gt;Output yang Diharapkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:12%;&quot;&gt;Hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pembayaran via Midtrans (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik tombol Bayar Sekarang pada halaman pembayaran&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pop-up Snap Midtrans terbuka menampilkan kanal QRIS, Virtual Account Bank, dan E-Wallet&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Cek status pembayaran Midtrans (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik tombol Sudah Bayar? Cek Status Pembayaran&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Sistem memeriksa status transaksi ke server Midtrans dan menampilkan status pembayaran terkini&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Konfirmasi pelunasan Webhook (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Server Midtrans mengirim sinyal notifikasi settlement (lunas)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Status pendaftaran di basis data otomatis berubah menjadi approved (lunas) secara real-time&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pembayaran transfer manual (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Pilih metode transfer manual dan upload foto bukti transfer&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Berkas bukti bayar tersimpan dan status pendaftaran menjadi pending verifikasi admin&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Upload bukti transfer bukan gambar (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Unggah berkas dokumen (contoh: format .pdf atau .docx)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;File bukti pembayaran harus berupa gambar (jpeg, png, jpg, webp)&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Upload bukti transfer melebihi 5MB (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Unggah file gambar berukuran lebih dari 5 MB&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;Ukuran maksimal file bukti pembayaran adalah 5MB&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="65" y="1553" width="720" height="336" as="geometry" />
