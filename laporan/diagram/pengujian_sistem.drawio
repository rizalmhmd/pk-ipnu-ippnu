        <mxCell id="tbl_1" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:&#39;Times New Roman&#39;;font-size:12px;color:#000000;border:1px solid #000000;&quot;&gt;&lt;tr style=&quot;font-weight:bold;text-align:center;background-color:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:6%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:24%;&quot;&gt;Fitur yang Diuji&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:30%;&quot;&gt;Input yang Diberikan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:28%;&quot;&gt;Output yang Diharapkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:12%;&quot;&gt;Hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan Beranda utama (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Mengakses URL utama sistem ( / )&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Tampilan beranda lengkap berisi banner hero, statistik, warta terbaru, dan agenda terdekat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Scroll navbar sticky (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Gulir halaman ke bawah melebihi 50px&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Bilah navigasi berubah latar menjadi hijau pekat berbayang dan tetap melayang&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Navigasi menu Profil (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik menu Profil &gt; Visi &amp; Misi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan halaman profil visi dan misi organisasi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Melihat detail berita (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik salah satu kartu berita pada beranda&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan halaman warta berita lengkap dengan foto utama, penulis, tanggal, dan isi berita&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Melihat detail artikel opini (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik salah satu kartu artikel opini&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan narasi opini lengkap beserta nama kader penulis dan foto pendukung&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Melihat galeri dokumentasi (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik menu Galeri pada navigasi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan foto-foto dokumentasi kegiatan organisasi dalam format grid responsif&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Melihat daftar agenda kegiatan (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik menu Agenda pada navigasi&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Menampilkan daftar kegiatan yang diurutkan dari tanggal pelaksanaan terdekat&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="65" y="611" width="720" height="386" as="geometry" />
        </mxCell>
        <mxCell id="sub_2" value="c.   Pengujian Fitur Formulir Pendaftaran Kegiatan" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#000000;fontFamily=Times New Roman;" vertex="1" parent="1">
