        <mxCell id="tbl_0" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-family:&#39;Times New Roman&#39;;font-size:12px;color:#000000;border:1px solid #000000;&quot;&gt;&lt;tr style=&quot;font-weight:bold;text-align:center;background-color:#ffffff;&quot;&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:6%;&quot;&gt;No&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:24%;&quot;&gt;Fitur yang Diuji&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:30%;&quot;&gt;Input yang Diberikan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;width:28%;&quot;&gt;Output yang Diharapkan&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;width:12%;&quot;&gt;Hasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Login (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Email dan password valid (Role Administrator)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Masuk ke dashboard admin dengan hak akses menu penuh&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Login (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Email dan password valid (Role Ketua IPNU/IPPNU)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Masuk ke dashboard dengan batasan menu khusus Ketua (Agenda, Pendaftar, Anggota, Galeri)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Login (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Email dan password valid (Role Departemen)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Masuk ke dashboard dengan menu khusus pengelolaan konten (Berita, Artikel, Quotes)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Login (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Password salah&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;Kredensial yang diberikan tidak cocok dengan data kami&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;5&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Login (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Format email tidak valid (contoh: bukan-email)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Muncul pesan error: &quot;Format email tidak valid&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;6&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Lihat kata sandi (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik ikon mata pada kolom password&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Karakter password tampil secara terbuka (teks biasa)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;7&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Akses halaman admin tanpa login (gagal)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Akses URL /admin/dashboard secara langsung di browser&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Akses ditolak oleh middleware auth dan dialihkan ke halaman login&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;&quot;&gt;8&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Logout dari sistem (berhasil)&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Klik tombol Keluar pada sidebar&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px;&quot;&gt;Sesi login dihapus dan diarahkan kembali ke beranda utama publik&lt;/td&gt;&lt;td style=&quot;border:1px solid #000000;padding:6px 4px;text-align:center;font-weight:bold;color:#000000;&quot;&gt;&amp;#9989;&lt;br/&gt;Berhasil&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=lef